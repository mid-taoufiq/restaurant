{% extends 'base.html.twig' %}
{% block title %}Seasonal Menu & Allergens — Le Bistro 60{% endblock %}

{% block body %}
<div class="card">
    <h1 style="margin-top:0;">Seasonal Menu Card (60 Covers)</h1>
    <p style="color:#475569; margin-bottom:0;">Real-time dish availability based on kitchen stock and allergens synced with Open Food Facts.</p>
</div>

<div class="card">
    <h2 style="margin-top:0;">Composed Menus (Formulas)</h2>
    <div class="grid">
        {% for menu in menus %}
            <div style="border:1px solid #cbd5e1; border-radius:8px; padding:1rem;">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <strong>{{ menu.name }}</strong>
                    <span class="badge badge-ok">{{ menu.price|number_format(2) }} €</span>
                </div>
                <p style="font-size:0.88rem; color:#64748b; margin:0.4rem 0;">{{ menu.description }}</p>
                <div style="font-size:0.85rem;">
                    Includes:
                    {% for d in menu.dishes %}
                        <span class="badge">{{ d.name }}</span>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<div class="card">
    <h2 style="margin-top:0;">À La Carte Dishes ({{ dishCards|length }})</h2>
    <table>
        <thead>
            <tr>
                <th>Dish</th>
                <th>Category</th>
                <th>Price</th>
                <th>Allergens (Open Food Facts / Recipe)</th>
                <th>Availability</th>
            </tr>
        </thead>
        <tbody>
            {% for item in dishCards %}
                <tr>
                    <td><strong>{{ item.dish.name }}</strong></td>
                    <td><span class="badge">{{ item.dish.category|upper }}</span></td>
                    <td>{{ item.dish.price|number_format(2) }} €</td>
                    <td>
                        {% if item.allergens is empty %}
                            <span style="color:#64748b; font-size:0.85rem;">None declared</span>
                        {% else %}
                            {% for alg in item.allergens %}
                                <span class="badge badge-warn">{{ alg }}</span>
                            {% endfor %}
                        {% endif %}
                    </td>
                    <td>
                        {% if item.available %}
                            <span class="badge badge-ok">Available</span>
                        {% else %}
                            <span class="badge badge-err">Unavailable (Missing: {{ item.missing|join(', ') }})</span>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
